<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= couple.brideName %> & <%= couple.groomName %> - Wedding Invitation</title>
    
    <!-- Google Fonts for Vietnamese Support -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700&family=Dancing+Script:wght@400;600&family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Great+Vibes&family=Montserrat:wght@300;400;500&family=Playfair+Display:wght@400;600&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="/css/style.css">

    <!-- AOS (Animate On Scroll) CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css" />
</head>
<%
    const themeConfig = theme || {};
    const chibi = themeConfig.chibi || {};
    const watercolor = themeConfig.watercolor || {};
    const layer1 = chibi.layer1Url ? `url('${chibi.layer1Url}')` : 'none';
    const layer2 = chibi.layer2Url ? `url('${chibi.layer2Url}')` : 'none';
    const washLayer = watercolor.washUrl ? `url('${watercolor.washUrl}')` : 'none';
    const lineLayer = watercolor.lineArtUrl ? `url('${watercolor.lineArtUrl}')` : 'none';
    const themeClass = themeConfig.backgroundStyle === 'watercolor'
        ? 'theme-watercolor'
        : (themeConfig.backgroundStyle === 'chibi' && chibi.enabled ? 'theme-chibi' : '');
%>
<body class="<%= themeClass %>" style="--chibi-base: <%= chibi.baseColor || '#fff5f4' %>; --chibi-accent: <%= chibi.accentColor || '#f8d9e0' %>; --chibi-layer-1: <%- layer1 %>; --chibi-layer-2: <%- layer2 %>; --chibi-float-duration: <%= (chibi.floatDuration || 12) %>s; --watercolor-base: <%= watercolor.baseColor || '#f9f3ee' %>; --watercolor-wash: <%- washLayer %>; --watercolor-lineart: <%- lineLayer %>; --font-body: <%- themeConfig.fontBody || "'Be Vietnam Pro', 'Segoe UI', 'Arial', sans-serif" %>; --font-script: <%- themeConfig.fontScript || "'Dancing Script', 'Brush Script MT', cursive" %>;">
    <!-- Music Player (Hidden by default) -->
    <div id="music-player" class="music-player">
        <button id="music-toggle" class="music-btn" title="Phát nhạc">🎵</button>
        <audio id="background-music" loop></audio>
    </div>

    <!-- Floating petals -->
    <div id="petals"></div>
    <div id="butterfly" class="butterfly" aria-hidden="true">
        <div class="butterfly-wing left"></div>
        <div class="butterfly-wing right"></div>
        <div class="butterfly-body"></div>
    </div>

    <!-- ── VENUE SELECTOR ── -->
    <div id="venue-selector" class="venue-selector active">
        <div class="venue-selector-content">
            <div class="venue-buttons">
                <div class="venue-btn groom-venue" onclick="selectVenue('groom'); return false;">
                    <h2>Tiệc Nhà Trai</h2>
                    <p><%= wedding.groomReception.location %></p>
                </div>

                <div class="venue-logo">
                    <img src="/image/logocuoi.jpg" alt="Logo">
                </div>

                <div class="venue-btn bride-venue" onclick="selectVenue('bride'); return false;">
                    <h2>Tiệc Nhà Gái</h2>
                    <p><%= wedding.brideReception.location %></p>
                </div>
            </div>
        </div>
    </div>

    <!-- ── LANDING ── -->
    <div id="landing">
      <div class="landing-names-section">
        <span class="landing-name"><%= couple.brideName %></span>
        <span class="landing-heart">❤</span>
        <span class="landing-name"><%= couple.groomName %></span>
      </div>

      <div class="landing-envelope-wrapper" id="envWrap" onclick="openCard()">
        <div class="landing-envelope">
          <div class="landing-flap"></div>
          <div class="landing-seal"></div>
        </div>
      </div>

      <div class="landing-cta">CLICK VÀO THIỆP ĐỂ MỞ</div>

      <div class="landing-photo-section">
        <% if (preWeddingPhoto) { %>
          <img src="<%= preWeddingPhoto %>" alt="Pre-wedding" class="landing-photo">
        <% } %>
      </div>
    </div>

    <!-- ── INVITATION CARD ── -->
    <div id="card">
      <div class="card-hero">
                <div class="hero-photo-blur" style="background-image:url('/image/anhcuoi2.jpg')"></div>
                <img src="/image/anhcuoi4.jpg" alt="Wedding photo" class="hero-photo">
        <!-- Decorative botanical SVG overlay -->
        <svg style="position:absolute;inset:0;width:100%;height:100%;opacity:.18" viewBox="0 0 400 533" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
          <ellipse cx="60" cy="80" rx="35" ry="55" fill="#fff" transform="rotate(-20 60 80)"/>
          <ellipse cx="340" cy="100" rx="28" ry="50" fill="#fff" transform="rotate(25 340 100)"/>
          <ellipse cx="30" cy="200" rx="22" ry="45" fill="#fff" transform="rotate(-35 30 200)"/>
          <ellipse cx="370" cy="300" rx="25" ry="40" fill="#fff" transform="rotate(15 370 300)"/>
          <ellipse cx="200" cy="20" rx="40" ry="18" fill="#fff" transform="rotate(5 200 20)"/>
          <circle cx="200" cy="60" r="22" fill="#fff"/>
        </svg>
        <div class="hero-overlay"></div>
        <div class="hero-text">
          <div class="hero-names">
            <%= couple.brideName %><span class="hero-heart">♥</span><%= couple.groomName %>
          </div>
        </div>
                <div class="hero-invite">
                    <p class="hero-invite-line">Trân trọng kính mời</p>
                    <p class="hero-invite-name">Quý khách</p>
                </div>
      </div>

      <div class="divider" style="margin-top:2.5rem">
        <span class="divider-icon">✦</span>
      </div>

            <section class="map-section" style="padding: 0 2rem 2.5rem">
                <h2>Địa điểm tổ chức</h2>
                <div class="map-container">
                    <iframe src="https://maps.google.com/maps?q=<%= wedding.coordinates.lat %>,<%= wedding.coordinates.lng %>&z=15&output=embed"
                                    width="100%" height="280" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
                </div>
                <p class="map-address"><%= wedding.receptionAddress %></p>
            </section>

            <%
                const ceremonyDate = new Date(wedding.ceremonyDate);
                const calYear = ceremonyDate.getFullYear();
                const calMonth = ceremonyDate.getMonth();
                const calDay = ceremonyDate.getDate();
                const firstDow = new Date(calYear, calMonth, 1).getDay();
                const leadingEmpty = (firstDow + 6) % 7;
                const daysInMonth = new Date(calYear, calMonth + 1, 0).getDate();
                const monthLabel = `Tháng ${calMonth + 1}`;
                const weekLabels = ['T2', 'T3', 'T4', 'T5', 'T6', 'T7', 'CN'];
            %>
            <section class="calendar-section">
                <div class="countdown-wrap" data-aos="zoom-in">
                    <div class="countdown-title">Thời gian đếm ngược</div>
                    <div class="countdown-boxes" id="countdown" data-date="<%= wedding.ceremonyDate %>" data-time="<%= wedding.ceremonyTime %>">
                        <div class="countdown-unit">
                            <div class="countdown-box" id="days">00</div>
                            <div class="countdown-label">Ngày</div>
                        </div>
                        <div class="countdown-sep">:</div>
                        <div class="countdown-unit">
                            <div class="countdown-box" id="hours">00</div>
                            <div class="countdown-label">Giờ</div>
                        </div>
                        <div class="countdown-sep">:</div>
                        <div class="countdown-unit">
                            <div class="countdown-box" id="minutes">00</div>
                            <div class="countdown-label">Phút</div>
                        </div>
                        <div class="countdown-sep">:</div>
                        <div class="countdown-unit">
                            <div class="countdown-box" id="seconds">00</div>
                            <div class="countdown-label">Giây</div>
                        </div>
                    </div>
                </div>
                <div class="calendar-title">
                    <div class="calendar-year"><%= calYear %></div>
                    <div class="calendar-month"><%= monthLabel %></div>
                </div>
                <div class="calendar-card">
                    <div class="calendar-bg" style="background-image:url('/image/damcuoi1.jpg')"></div>
                    <div class="calendar-overlay"></div>
                    <div class="calendar-grid calendar-header">
                        <% weekLabels.forEach(label => { %>
                            <div class="calendar-cell"><%= label %></div>
                        <% }); %>
                    </div>
                    <div class="calendar-grid calendar-days">
                        <% for (let i = 0; i < leadingEmpty; i++) { %>
                            <div class="calendar-cell is-empty"></div>
                        <% } %>
                        <% for (let d = 1; d <= daysInMonth; d++) { %>
                            <div class="calendar-cell <%= d === calDay ? 'is-selected' : '' %>">
                                <span><%= d %></span>
                            </div>
                        <% } %>
                    </div>
                </div>
            </section>

    </div>

    <div class="wedding-container">

        <!-- Wedding Details -->
        <section class="wedding-details-section" data-aos="fade-up">
            <h2>Chi Tiết Lễ Cưới</h2>
            <div class="details-grid">
                <div class="detail-card ceremony">
                    <h3>Lễ Vu Quy / Thành Hôn</h3>
                    <p class="time"><%= wedding.ceremonyTime %></p>
                    <p class="location"><%= wedding.ceremonyLocation %></p>
                </div>
                <div class="detail-card reception">
                    <h3>Tiệc Cưới</h3>
                    <p class="time"><%= wedding.receptionTime %></p>
                    <p class="location"><%= wedding.receptionLocation %></p>
                </div>
            </div>
        </section>

        <!-- Love Story (Replaced with invitation card) -->
        <section class="love-story-section story-card-section" data-aos="fade-up">
            <h2>Thiệp Mời</h2>
            <%
                const inviteWeekday = ceremonyDate.toLocaleDateString('vi-VN', { weekday: 'long' });
            %>
            <div class="story-card-wrap">
                <div class="invite-card">
                    <svg class="floral-corner" viewBox="0 0 160 150" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M-5 155 Q30 100 80 50" stroke="#8aaa78" stroke-width="1.4" fill="none"/>
                        <path d="M-5 155 Q40 110 100 70" stroke="#8aaa78" stroke-width="0.8" fill="none" opacity="0.5"/>
                        <path d="M10 130 Q40 90 70 40" stroke="#8aaa78" stroke-width="0.9" fill="none" opacity="0.6"/>
                        <path d="M30 140 Q55 110 90 75" stroke="#8aaa78" stroke-width="0.7" fill="none" opacity="0.4"/>

                        <ellipse cx="68" cy="58" rx="15" ry="7" fill="#8aaa78" opacity="0.55" transform="rotate(-50 68 58)"/>
                        <ellipse cx="48" cy="82" rx="13" ry="6.5" fill="#8aaa78" opacity="0.5" transform="rotate(-35 48 82)"/>
                        <ellipse cx="28" cy="110" rx="12" ry="6" fill="#8aaa78" opacity="0.45" transform="rotate(-20 28 110)"/>
                        <ellipse cx="88" cy="42" rx="11" ry="5.5" fill="#aac898" opacity="0.45" transform="rotate(-60 88 42)"/>
                        <ellipse cx="35" cy="100" rx="10" ry="5" fill="#aac898" opacity="0.4" transform="rotate(-15 35 100)"/>
                        <ellipse cx="72" cy="72" rx="10" ry="5" fill="#8aaa78" opacity="0.38" transform="rotate(-45 72 72)"/>

                        <circle cx="82" cy="36" r="9" fill="white" opacity="0.9"/>
                        <ellipse cx="82" cy="26" rx="4" ry="5.5" fill="white" opacity="0.8"/>
                        <ellipse cx="82" cy="46" rx="4" ry="5.5" fill="white" opacity="0.8"/>
                        <ellipse cx="72" cy="36" rx="5.5" ry="4" fill="white" opacity="0.8"/>
                        <ellipse cx="92" cy="36" rx="5.5" ry="4" fill="white" opacity="0.8"/>
                        <ellipse cx="75" cy="29" rx="4.5" ry="5" fill="white" opacity="0.65" transform="rotate(-45 75 29)"/>
                        <ellipse cx="89" cy="29" rx="4.5" ry="5" fill="white" opacity="0.65" transform="rotate(45 89 29)"/>
                        <ellipse cx="75" cy="43" rx="4.5" ry="5" fill="white" opacity="0.65" transform="rotate(45 75 43)"/>
                        <ellipse cx="89" cy="43" rx="4.5" ry="5" fill="white" opacity="0.65" transform="rotate(-45 89 43)"/>
                        <circle cx="82" cy="36" r="5" fill="#e8d0a0" opacity="0.9"/>
                        <circle cx="82" cy="36" r="3" fill="#c9a96e" opacity="0.9"/>
                        <circle cx="82" cy="36" r="1.5" fill="#a07830"/>

                        <circle cx="48" cy="70" r="7" fill="white" opacity="0.85"/>
                        <ellipse cx="48" cy="62" rx="3" ry="4.5" fill="white" opacity="0.75"/>
                        <ellipse cx="48" cy="78" rx="3" ry="4.5" fill="white" opacity="0.75"/>
                        <ellipse cx="40" cy="70" rx="4.5" ry="3" fill="white" opacity="0.75"/>
                        <ellipse cx="56" cy="70" rx="4.5" ry="3" fill="white" opacity="0.75"/>
                        <ellipse cx="42" cy="64" rx="3.5" ry="4" fill="white" opacity="0.55" transform="rotate(-45 42 64)"/>
                        <ellipse cx="54" cy="64" rx="3.5" ry="4" fill="white" opacity="0.55" transform="rotate(45 54 64)"/>
                        <ellipse cx="42" cy="76" rx="3.5" ry="4" fill="white" opacity="0.55" transform="rotate(45 42 76)"/>
                        <ellipse cx="54" cy="76" rx="3.5" ry="4" fill="white" opacity="0.55" transform="rotate(-45 54 76)"/>
                        <circle cx="48" cy="70" r="4" fill="#e8d0a0" opacity="0.9"/>
                        <circle cx="48" cy="70" r="2.5" fill="#c9a96e"/>

                        <circle cx="105" cy="60" r="5" fill="white" opacity="0.8"/>
                        <ellipse cx="105" cy="54" rx="2.5" ry="3.5" fill="white" opacity="0.7"/>
                        <ellipse cx="105" cy="66" rx="2.5" ry="3.5" fill="white" opacity="0.7"/>
                        <ellipse cx="99" cy="60" rx="3.5" ry="2.5" fill="white" opacity="0.7"/>
                        <ellipse cx="111" cy="60" rx="3.5" ry="2.5" fill="white" opacity="0.7"/>
                        <circle cx="105" cy="60" r="3" fill="#e8d0a0"/>
                        <circle cx="105" cy="60" r="1.8" fill="#c9a96e"/>

                        <circle cx="95" cy="22" r="3" fill="#c9a96e" opacity="0.7"/>
                        <circle cx="100" cy="15" r="2" fill="#c9a96e" opacity="0.55"/>
                        <circle cx="108" cy="22" r="2.5" fill="#e8d5a0" opacity="0.65"/>
                        <circle cx="20" cy="120" r="2.5" fill="#c9a96e" opacity="0.5"/>
                        <circle cx="12" cy="112" r="2" fill="#c9a96e" opacity="0.45"/>

                        <path d="M82 36 Q88 20 96 14" stroke="#8aaa78" stroke-width="0.8" fill="none" opacity="0.6"/>
                        <path d="M82 36 Q72 22 70 14" stroke="#8aaa78" stroke-width="0.7" fill="none" opacity="0.5"/>
                        <path d="M48 70 Q38 58 30 52" stroke="#8aaa78" stroke-width="0.7" fill="none" opacity="0.5"/>
                    </svg>

                    <div class="invite-photos-area">
                        <div class="polaroid polaroid-groom">
                            <div class="photo-frame">
                                <img src="/image/chure.jpg" alt="Anh chu re" loading="lazy">
                            </div>
                                <div class="polaroid-caption">
                                    <span class="role">Chú rể</span>
                                    <span class="name"><%= couple.groomName %></span>
                                </div>
                        </div>

                        <div class="polaroid polaroid-bride">
                            <div class="photo-frame">
                                <img src="/image/codau.jpg" alt="Anh co dau" loading="lazy">
                            </div>
                                <div class="polaroid-caption">
                                    <span class="role">Cô dâu</span>
                                    <span class="name"><%= couple.brideName %></span>
                                </div>
                        </div>
                    </div>

                    <div class="invite-bottom">
                        <div class="invite-divider"><span>✦</span></div>
                        <p class="invite-text">
                            Trân trọng kính mời quý khách<br>đến dự lễ thành hôn của chúng tôi
                        </p>
                        <div class="invite-divider"><span>✦</span></div>
                    </div>
                </div>
            </div>

            <div class="story-family">
                <h3 class="story-family-title">Gia Đình</h3>
                <div class="parents-grid">
                    <div class="parent-info bride-side">
                        <h4>Gia Đình Cô Dâu</h4>
                        <p>Ông: <%= couple.parentsBride.father %></p>
                        <p>Bà: <%= couple.parentsBride.mother %></p>
                    </div>
                    <div class="parent-info groom-side">
                        <h4>Gia Đình Chú Rể</h4>
                        <p>Ông: <%= couple.parentsGroom.father %></p>
                        <p>Bà: <%= couple.parentsGroom.mother %></p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Photo Gallery Editorial -->
        <% if (gallery && gallery.length > 0) { %>
            <section class="gallery-section" data-aos="fade-up">
                <h2>Album Ảnh</h2>
                <div class="gallery-filter">
                    <button class="filter-btn active" data-filter="all">Tất Cả</button>
                    <button class="filter-btn" data-filter="ceremony">Lễ Cưới</button>
                    <button class="filter-btn" data-filter="reception">Tiệc Cưới</button>
                    <button class="filter-btn" data-filter="moments">Khoảnh Khắc</button>
                </div>

                <div class="gallery-editorial">
                    <% gallery.forEach((photo, index) => { %>
                        <%
                            const layoutClass = index === 0
                                ? 'editorial-item--hero'
                                : (index % 5 === 1
                                    ? 'editorial-item--tall'
                                    : (index % 5 === 2
                                        ? 'editorial-item--wide'
                                        : 'editorial-item--square'));
                        %>
                        <figure class="editorial-item <%= layoutClass %>" data-category="<%= photo.category || 'all' %>">
                            <div class="editorial-media">
                                <img src="<%= photo.url %>" alt="<%= photo.caption %>" loading="lazy">
                            </div>
                            <figcaption class="editorial-caption"><%= photo.caption %></figcaption>
                        </figure>
                    <% }); %>
                </div>
                <div class="gallery-pagination" aria-label="Album pages" role="tablist"></div>
            </section>
        <% } %>

        <!-- Pre-Wedding Video -->
        <% if (preWeddingVideo) { %>
            <section class="video-section">
                <h2>Video Trước Lễ Cưới</h2>
                <div class="video-container">
                    <iframe width="100%" height="315" src="<%= preWeddingVideo %>"
                            frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                </div>
            </section>
        <% } %>


        <!-- Digital Gift / Mừng Cưới -->
        <section class="gift-section is-hidden">
            <h2>Mừng Cưới</h2>
            <div class="gift-container">
                <p class="gift-text">Cảm ơn tình cảm của quý khách!</p>
                <div class="bank-info">
                    <p><strong>Ngân hàng:</strong> <%= digitalGift.bankName %></p>
                    <p><strong>Chủ tài khoản:</strong> <%= digitalGift.accountHolder %></p>
                    <p><strong>Số tài khoản:</strong> <%= digitalGift.accountNumber %></p>
                </div>
                <% if (digitalGift.qrCode) { %>
                    <div class="qr-code-container">
                        <img src="<%= digitalGift.qrCode %>" alt="QR Code">
                    </div>
                <% } %>
            </div>
        </section>

        <!-- RSVP Section -->
        <section class="rsvp-section is-hidden">
            <h2>Xác Nhận Tham Dự</h2>
            <form id="rsvp-form" class="rsvp-form">
                <input type="text" name="guestName" placeholder="Tên quý khách" required>
                <input type="tel" name="phoneNumber" placeholder="Số điện thoại" required>
                <select name="attendance" required>
                    <option value="">-- Chọn --</option>
                    <option value="true">Tôi sẽ tham dự</option>
                    <option value="false">Xin lỗi, tôi không thể tham dự</option>
                </select>
                <input type="number" name="numberOfGuests" placeholder="Số người đi cùng" min="1" value="1">
                <input type="text" name="dietaryPreferences" placeholder="Yêu cầu đặc biệt (ăn chay, dị ứng...)">
                <button type="submit" class="btn-submit">Gửi Xác Nhận</button>
            </form>
        </section>

        <!-- Guestbook Section -->
        <section class="guestbook-section">
            <h2>Sổ Ghi Chú Lời Chúc</h2>
            <form id="guestbook-form" class="guestbook-form">
                <input type="text" name="guestName" placeholder="Tên của bạn" required>
                <textarea name="message" placeholder="Lời chúc của bạn..." rows="4" required></textarea>
                <button type="submit" class="btn-submit">Gửi Lời Chúc</button>
            </form>

            <div class="guestbook-entries">
                <h3>Lời Chúc Từ Khách Mời</h3>
                <% guestbookEntries.forEach(entry => { %>
                    <div class="guestbook-entry">
                        <strong><%= entry.guestName %></strong>
                        <p><%= entry.message %></p>
                        <small><%= new Date(entry.timestamp).toLocaleDateString('vi-VN') %></small>
                    </div>
                <% }); %>
            </div>
        </section>

        <!-- QR Code for Website -->
        <section class="qr-website-section">
            <h2>Chia Sẻ Mời Cưới</h2>
            <div class="qr-container">
                <img src="<%= qrCode %>" alt="Website QR Code" class="website-qr">
                <p>Quét mã để truy cập thiệp cưới</p>
            </div>
        </section>

        <!-- Footer -->
        <footer class="footer">
            <p>Trân trọng cảm ơn sự tham dự của quý khách</p>
            <p><%= couple.brideName %> & <%= couple.groomName %></p>
        </footer>
    </div>

    <div id="lightbox" class="lightbox" aria-hidden="true">
        <div class="lightbox-content">
            <button type="button" class="close" aria-label="Dong">&times;</button>
            <img id="lightbox-image" src="" alt="Anh phong lon">
            <div class="nav-buttons">
                <button type="button" class="lightbox-prev" aria-label="Anh truoc">&#10094;</button>
                <button type="button" class="lightbox-next" aria-label="Anh sau">&#10095;</button>
            </div>
        </div>
    </div>

    <!-- AOS JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>

    <!-- Main JS -->
    <script src="/js/main.js"></script>
</body>
</html>
